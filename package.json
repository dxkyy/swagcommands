{
  "name": "swagcommands",
  "version": "2.0.0",
  "description": "",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./dist/index.mjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "compile": "npm run build",
    "compile:watch": "tsc -w -p tsconfig.json",
    "prepack": "npm run build",
    "test": "vitest run && npm run test:package",
    "test:package": "node scripts/test-package.mjs",
    "test:typecheck": "tsc --noEmit -p tsconfig.test.json",
    "test:watch": "vitest"
  },
  "keywords": [
    "discord",
    "discord.js",
    "bot",
    "command handler"
  ],
  "author": "dxkyy",
  "license": "ISC",
  "dependencies": {
    "colorette": "^2.0.20",
    "discord.js": "^14.27.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dxkyy/swagcommands"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
